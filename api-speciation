openapi: 3.0.3
info:
  title: CAB System REST API Specification
  description: >
    Tài liệu đặc tả API đầy đủ cho Hệ thống Đặt xe CAB (CAB System),
    đáp ứng toàn bộ các yêu cầu chức năng từ FR01 đến FR68.
  version: 1.0.0
servers:
  - url: https://api.cabsystem.com/v1
    description: Production Server

paths:

  # =================================================================
  # NHÓM 1: ACCOUNT & AUTHENTICATION (FR01 - FR05)
  # =================================================================

  /auth/register/customer:
    post:
      summary: FR01 - Đăng ký tài khoản khách hàng
      description: Cho phép khách hàng mới tạo tài khoản trên hệ thống CAB.
      operationId: registerCustomer
      tags:
        - Account & Authentication
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - fullName
                - phone
                - password
              properties:
                fullName:
                  type: string
                  example: "Nguyen Van A"
                phone:
                  type: string
                  example: "0901234567"
                email:
                  type: string
                  format: email
                  example: "nguyenvana@gmail.com"
                password:
                  type: string
                  format: password
                  example: "SecretPassword123!"
      responses:
        '201':
          description: Đăng ký tài khoản thành công.
          content:
            application/json:
              schema:
                type: object
                properties:
                  customerId:
                    type: integer
                    example: 101
                  message:
                    type: string
                    example: "Đăng ký thành công"

  /auth/login:
    post:
      summary: FR02 & FR05 - Đăng nhập & Xác thực người dùng
      description: Xác thực Khách hàng hoặc Tài xế và trả về JWT Bearer token.
      operationId: login
      tags:
        - Account & Authentication
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - phone
                - password
              properties:
                phone:
                  type: string
                  example: "0901234567"
                password:
                  type: string
                  format: password
                  example: "SecretPassword123!"
      responses:
        '200':
          description: Đăng nhập thành công, trả về Access Token.
          content:
            application/json:
              schema:
                type: object
                properties:
                  accessToken:
                    type: string
                    example: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  userType:
                    type: string
                    enum: [CUSTOMER, DRIVER, OPERATION_STAFF]
                    example: "CUSTOMER"

  /customers/profile:
    put:
      summary: FR03 - Cập nhật thông tin cá nhân khách hàng
      description: Cho phép khách hàng chỉnh sửa hồ sơ thông tin cá nhân.
      operationId: updateCustomerProfile
      tags:
        - Account & Authentication
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                fullName:
                  type: string
                  example: "Nguyen Van A (Updated)"
                email:
                  type: string
                  format: email
                  example: "nguyenvana_new@gmail.com"
      responses:
        '200':
          description: Cập nhật thành công.

  /auth/register/driver:
    post:
      summary: FR04 - Tài xế đăng ký / Nhân viên vận hành tạo tài khoản tài xế
      description: Tạo tài khoản tài xế mới.
      operationId: registerDriver
      tags:
        - Account & Authentication
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - fullName
                - phone
                - password
              properties:
                fullName:
                  type: string
                  example: "Tran Van B"
                phone:
                  type: string
                  example: "0987654321"
                email:
                  type: string
                  format: email
                  example: "tranvanb@gmail.com"
                password:
                  type: string
                  format: password
                  example: "DriverPass123!"
      responses:
        '201':
          description: Đăng ký tài xế thành công.

  # =================================================================
  # NHÓM 2: BOOKING (FR06 - FR10)
  # =================================================================

  /trip-requests:
    post:
      summary: FR06 - FR10 - Tạo yêu cầu đặt xe
      description: Khách hàng nhập điểm đón, điểm đến, loại xe và gửi yêu cầu đặt xe.
      operationId: createTripRequest
      tags:
        - Booking
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - pickupLocation
                - destination
                - vehicleType
              properties:
                pickupLocation:
                  type: string
                  example: "123 Nguyen Hue, Quan 1, TP.HCM"
                pickupLat:
                  type: number
                  format: double
                  example: 10.7769
                pickupLng:
                  type: number
                  format: double
                  example: 106.7009
                destination:
                  type: string
                  example: "San bay Tan Son Nhat, Tan Binh, TP.HCM"
                destinationLat:
                  type: number
                  format: double
                  example: 10.8185
                destinationLng:
                  type: number
                  format: double
                  example: 106.6588
                vehicleType:
                  type: string
                  enum: [CAR_4_SEATS, CAR_7_SEATS, BIKE]
                  example: "CAR_4_SEATS"
      responses:
        '201':
          description: Yêu cầu đặt xe đã được tạo thành công và bắt đầu tìm tài xế.
          content:
            application/json:
              schema:
                type: object
                properties:
                  requestId:
                    type: integer
                    example: 5001
                  status:
                    type: string
                    example: "SEARCHING_DRIVER"

  /trip-requests/{requestId}:
    get:
      summary: FR10 - Theo dõi trạng thái yêu cầu đặt xe
      description: Tra cứu trạng thái yêu cầu tìm tài xế.
      operationId: getTripRequestStatus
      tags:
        - Booking
      security:
        - BearerAuth: []
      parameters:
        - name: requestId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Trạng thái hiện tại của yêu cầu.

  # =================================================================
  # NHÓM 3: DRIVER & VEHICLE (FR11 - FR15)
  # =================================================================

  /drivers/profile:
    put:
      summary: FR11 - Cập nhật hồ sơ tài xế
      description: Cho phép tài xế cập nhật thông tin cá nhân.
      operationId: updateDriverProfile
      tags:
        - Driver & Vehicle
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                fullName:
                  type: string
                  example: "Tran Van B"
      responses:
        '200':
          description: Cập nhật thành công.

  /drivers/vehicles:
    post:
      summary: FR12 - Cập nhật thông tin phương tiện
      description: Tài xế đăng ký/cập nhật xe sử dụng đón khách.
      operationId: updateVehicleInfo
      tags:
        - Driver & Vehicle
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - vehicleType
                - licensePlate
              properties:
                vehicleType:
                  type: string
                  example: "CAR_4_SEATS"
                licensePlate:
                  type: string
                  example: "51H-123.45"
                brand:
                  type: string
                  example: "Toyota"
                model:
                  type: string
                  example: "Vios"
      responses:
        '200':
          description: Thông tin phương tiện đã cập nhật.

  /drivers/availability:
    patch:
      summary: FR13 - Cập nhật trạng thái hoạt động (Sẵn sàng / Bận)
      description: Cho phép tài xế bật/tắt chế độ nhận chuyến.
      operationId: updateAvailability
      tags:
        - Driver & Vehicle
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - isAvailable
              properties:
                isAvailable:
                  type: boolean
                  example: true
      responses:
        '200':
          description: Đã chuyển đổi trạng thái sẵn sàng.

  /drivers/location:
    post:
      summary: FR14 - Cập nhật vị trí tài xế (Real-time GPS)
      description: Định kỳ gửi tọa độ hiện tại của tài xế về hệ thống.
      operationId: updateDriverLocation
      tags:
        - Driver & Vehicle
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - latitude
                - longitude
              properties:
                latitude:
                  type: number
                  format: double
                  example: 10.7770
                longitude:
                  type: number
                  format: double
                  example: 106.7010
      responses:
        '200':
          description: Đã cập nhật tọa độ thành công.

  /drivers/notifications/new-trips:
    get:
      summary: FR15 - Nhận thông báo chuyến mới cho tài xế
      description: Tra cứu yêu cầu chuyến đi vừa gửi đến cho tài xế.
      operationId: getDriverNewTripNotifications
      tags:
        - Driver & Vehicle
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Danh sách chuyến mới đang chờ tài xế phản hồi.

  # =================================================================
  # NHÓM 4: DRIVER MATCHING (FR16 - FR24)
  # =================================================================

  /matching/find-drivers:
    post:
      summary: FR16 - FR18 - Tìm & lọc tài xế phù hợp gần nhất
      description: Chức năng nội bộ/Matching Service tìm danh sách tài xế AVAILABLE, phù hợp loại xe và ưu tiên theo khoảng cách.
      operationId: findMatchingDrivers
      tags:
        - Driver Matching
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - requestId
              properties:
                requestId:
                  type: integer
                  example: 5001
      responses:
        '200':
          description: Trả về danh sách tài xế được đề xuất theo thứ tự ưu tiên.

  /matching/dispatch:
    post:
      summary: FR19 - Gửi yêu cầu chuyến đến tài xế được chọn
      description: Hệ thống gửi thông báo mời nhận chuyến đến tài xế ưu tiên.
      operationId: dispatchTripToDriver
      tags:
        - Driver Matching
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - requestId
                - driverId
              properties:
                requestId:
                  type: integer
                  example: 5001
                driverId:
                  type: integer
                  example: 201
      responses:
        '200':
          description: Đã gửi thông báo cho tài xế.

  /driver-assignments/{assignmentId}/accept:
    post:
      summary: FR20 - Tài xế chấp nhận chuyến
      description: Tài xế đồng ý nhận chuyến đi được đề xuất.
      operationId: acceptTrip
      tags:
        - Driver Matching
      security:
        - BearerAuth: []
      parameters:
        - name: assignmentId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Đã chấp nhận chuyến đi thành công.

  /driver-assignments/{assignmentId}/reject:
    post:
      summary: FR21 - FR23 - Tài xế từ chối chuyến & Tự động tìm tài xế tiếp theo
      description: Tài xế từ chối chuyến, hệ thống tự động ghi nhận và chuyển yêu cầu sang tài xế tiếp theo.
      operationId: rejectTrip
      tags:
        - Driver Matching
      security:
        - BearerAuth: []
      parameters:
        - name: assignmentId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Đã từ chối chuyến. Hệ thống đang tự động tìm tài xế khác.

  /matching/handle-timeout:
    post:
      summary: FR22 - FR23 - Xử lý tài xế không phản hồi (Timeout)
      description: Hệ thống kích hoạt khi hết thời gian chờ phản hồi của tài xế và tìm tài xế tiếp theo.
      operationId: handleDriverTimeout
      tags:
        - Driver Matching
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - assignmentId
              properties:
                assignmentId:
                  type: integer
                  example: 8001
      responses:
        '200':
          description: Xử lý timeout thành công, đã đề xuất tài xế tiếp theo.

  /matching/notify-no-driver:
    post:
      summary: FR24 - Thông báo cho khách hàng nếu không tìm được tài xế
      description: Gửi thông báo cho khách khi tất cả tài xế đều từ chối hoặc hết tài xế phù hợp.
      operationId: notifyNoDriverFound
      tags:
        - Driver Matching
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - requestId
              properties:
                requestId:
                  type: integer
                  example: 5001
      responses:
        '200':
          description: Đã gửi thông báo không tìm thấy tài xế.

  # =================================================================
  # NHÓM 5: TRIP MANAGEMENT (FR25 - FR32)
  # =================================================================

  /trips:
    post:
      summary: FR25 - Ghép tài xế với chuyến (Khởi tạo Trip)
      description: Tạo bản ghi Trip chính thức sau khi tài xế chấp nhận yêu cầu.
      operationId: createTrip
      tags:
        - Trip Management
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - requestId
                - driverId
              properties:
                requestId:
                  type: integer
                  example: 5001
                driverId:
                  type: integer
                  example: 201
      responses:
        '201':
          description: Chuyến đi đã được khởi tạo.

  /trips/{tripId}/status:
    patch:
      summary: FR26 - FR29 - Cập nhật trạng thái chuyến đi
      description: >
        Tài xế cập nhật trạng thái chuyến đi:
        - ARRIVED (FR26: Đã đến điểm đón)
        - PICKED_UP (FR27: Đã đón khách)
        - IN_PROGRESS (FR28: Đang di chuyển)
        - COMPLETED (FR29: Hoàn thành chuyến)
      operationId: updateTripStatus
      tags:
        - Trip Management
      security:
        - BearerAuth: []
      parameters:
        - name: tripId
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - status
              properties:
                status:
                  type: string
                  enum: [ARRIVED, PICKED_UP, IN_PROGRESS, COMPLETED]
                  example: "ARRIVED"
      responses:
        '200':
          description: Cập nhật trạng thái chuyến đi thành công.

  /trips/{tripId}/tracking:
    get:
      summary: FR30 - FR32 - Khách hàng theo dõi chuyến đi, tài xế và ETA
      description: Khách hàng xem vị trí hiện tại của tài xế, thông tin tài xế và thời gian dự kiến đến (ETA).
      operationId: trackTrip
      tags:
        - Trip Management
      security:
        - BearerAuth: []
      parameters:
        - name: tripId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Thông tin tracking chi tiết của chuyến đi.
          content:
            application/json:
              schema:
                type: object
                properties:
                  tripId:
                    type: integer
                    example: 9001
                  tripStatus:
                    type: string
                    example: "IN_PROGRESS"
                  driverInfo:
                    type: object
                    properties:
                      fullName:
                        type: string
                        example: "Tran Van B"
                      phone:
                        type: string
                        example: "0987654321"
                      licensePlate:
                        type: string
                        example: "51H-123.45"
                  currentDriverLocation:
                    type: object
                    properties:
                      lat:
                        type: number
                        example: 10.7772
                      lng:
                        type: number
                        example: 106.7012
                  estimatedArrivalTime:
                    type: string
                    format: date-time
                    example: "2026-09-09T19:35:00Z"

  # =================================================================
  # NHÓM 6: FARE & PAYMENT (FR33 - FR41)
  # =================================================================

  /trips/{tripId}/fare:
    post:
      summary: FR33 & FR34 - Lấy thông tin chuyến & Tính số tiền cước
      description: Lấy thông tin chuyến hoàn thành và tính số tiền phải trả dựa trên loại dịch vụ và quãng đường/thời gian.
      operationId: calculateFare
      tags:
        - Fare & Payment
      security:
        - BearerAuth: []
      parameters:
        - name: tripId
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Tính tiền thành công.
          content:
            application/json:
              schema:
                type: object
                properties:
                  tripId:
                    type: integer
                    example: 9001
                  fareAmount:
                    type: number
                    example: 125000.0

  /payments/process:
    post:
      summary: FR35 - FR38 - Thực hiện thanh toán (Tiền mặt hoặc Online)
      description: Cho phép chọn phương thức CASH hoặc ONLINE. Nếu ONLINE, gửi yêu cầu sang Payment Provider bên ngoài.
      operationId: processPayment
      tags:
        - Fare & Payment
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - tripId
                - paymentMethod
              properties:
                tripId:
                  type: integer
                  example: 9001
                paymentMethod:
                  type: string
                  enum: [CASH, ONLINE]
                  example: "ONLINE"
      responses:
        '200':
          description: Kết quả xử lý thanh toán.
          content:
            application/json:
              schema:
                type: object
                properties:
                  paymentId:
                    type: integer
                    example: 4001
                  status:
                    type: string
                    enum: [SUCCESS, FAILED, PENDING]
                    example: "SUCCESS"
                  paymentUrl:
                    type: string
                    example: "https://payment-provider.com/checkout?token=xyz"

  /payments/callback:
    post:
      summary: FR38 & FR39 - Nhận kết quả thanh toán từ Payment Provider & Ghi nhận giao dịch
      description: Webhook / Callback endpoint tiếp nhận phản hồi từ nhà cung cấp thanh toán bên ngoài.
      operationId: paymentCallback
      tags:
        - Fare & Payment
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - paymentId
                - providerReference
                - status
              properties:
                paymentId:
                  type: integer
                  example: 4001
                providerReference:
                  type: string
                  example: "PAY-GATEWAY-12345"
                status:
                  type: string
                  example: "SUCCESS"
      responses:
        '200':
          description: Đã ghi nhận kết quả giao dịch.

  /payments/{paymentId}/retry:
    post:
      summary: FR40 & FR41 - Thông báo & Cho phép thử lại/xử lý lại thanh toán thất bại
      description: Khi thanh toán online thất bại, cho phép người dùng thử lại hoặc đổi phương thức thanh toán.
      operationId: retryPayment
      tags:
        - Fare & Payment
      security:
        - BearerAuth: []
      parameters:
        - name: paymentId
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - newPaymentMethod
              properties:
                newPaymentMethod:
                  type: string
                  enum: [CASH, ONLINE]
                  example: "CASH"
      responses:
        '200':
          description: Đã tiếp nhận yêu cầu thanh toán lại.

  # =================================================================
  # NHÓM 7: NOTIFICATION (FR42 - FR48)
  # =================================================================

  /notifications/send:
    post:
      summary: FR42 - FR48 - Gửi thông báo hệ thống cho Khách hàng / Tài xế
      description: >
        Gửi thông báo các sự kiện quan trọng:
        - FR42: Đã tiếp nhận yêu cầu đặt xe
        - FR43: Tài xế nhận chuyến
        - FR44: Tài xế đã đến điểm đón
        - FR45: Hoàn thành chuyến đi
        - FR46: Kết quả thanh toán
        - FR47: Thông báo chuyến mới cho tài xế
        - FR48: Thay đổi liên quan đến chuyến
      operationId: sendNotification
      tags:
        - Notification
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - recipientId
                - recipientType
                - notificationType
                - message
              properties:
                recipientId:
                  type: integer
                  example: 101
                recipientType:
                  type: string
                  enum: [CUSTOMER, DRIVER]
                  example: "CUSTOMER"
                notificationType:
                  type: string
                  enum: [
                    BOOKING_RECEIVED,
                    DRIVER_ASSIGNED,
                    DRIVER_ARRIVED,
                    TRIP_COMPLETED,
                    PAYMENT_RESULT,
                    NEW_TRIP_REQUEST,
                    TRIP_UPDATED
                  ]
                  example: "DRIVER_ARRIVED"
                message:
                  type: string
                  example: "Tài xế Tran Van B đã đến điểm đón!"
      responses:
        '200':
          description: Đã gửi thông báo thành công.

  # =================================================================
  # NHÓM 8: HISTORY & RATING (FR49 - FR52)
  # =================================================================

  /customers/trip-history:
    get:
      summary: FR49 & FR50 - Xem lịch sử chuyến đi & Số tiền cước
      description: Cho phép khách hàng tra cứu lịch sử các chuyến đi đã thực hiện và số tiền tương ứng.
      operationId: getCustomerTripHistory
      tags:
        - History & Rating
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Danh sách lịch sử chuyến đi của khách hàng.

  /trips/{tripId}/rating:
    post:
      summary: FR51 & FR52 - Đánh giá tài xế & Lưu thông tin đánh giá
      description: Khách hàng gửi điểm số đánh giá và nhận xét sau khi hoàn thành chuyến đi.
      operationId: rateDriver
      tags:
        - History & Rating
      security:
        - BearerAuth: []
      parameters:
        - name: tripId
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - score
              properties:
                score:
                  type: integer
                  minimum: 1
                  maximum: 5
                  example: 5
                comment:
                  type: string
                  example: "Tài xế thân thiện, lái xe an toàn!"
      responses:
        '201':
          description: Đánh giá đã được ghi nhận.

  # =================================================================
  # NHÓM 9: OPERATION MANAGEMENT (FR53 - FR60)
  # =================================================================

  /admin/customers:
    get:
      summary: FR53 - Quản lý danh sách khách hàng
      description: Nhân viên vận hành xem danh sách và thông tin khách hàng.
      operationId: adminGetCustomers
      tags:
        - Operation Management
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Danh sách khách hàng.

  /admin/drivers:
    get:
      summary: FR54 & FR58 - Quản lý tài xế & Kiểm tra trạng thái tài xế
      description: Xem danh sách tài xế và trạng thái hoạt động hiện tại của họ.
      operationId: adminGetDrivers
      tags:
        - Operation Management
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Danh sách tài xế và trạng thái.

  /admin/vehicles:
    get:
      summary: FR55 - Quản lý phương tiện
      description: Xem danh sách phương tiện được đăng ký trong hệ thống.
      operationId: adminGetVehicles
      tags:
        - Operation Management
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Danh sách phương tiện.

  /admin/trips:
    get:
      summary: FR56 & FR57 - Quản lý chuyến đi & Xem các chuyến đang diễn ra
      description: Theo dõi các chuyến đi trên hệ thống, bao gồm các chuyến dang dở/đang diễn ra.
      operationId: adminGetTrips
      tags:
        - Operation Management
      security:
        - BearerAuth: []
      parameters:
        - name: status
          in: query
          required: false
          schema:
            type: string
            example: "IN_PROGRESS"
      responses:
        '200':
          description: Danh sách chuyến đi.

  /admin/trips/{tripId}/resolve-issue:
    post:
      summary: FR59 - Hỗ trợ xử lý trường hợp chuyến gặp lỗi
      description: Nhân viên vận hành thực hiện hỗ trợ thiệp/xử lý thủ công cho chuyến đi bị lỗi.
      operationId: resolveTripIssue
      tags:
        - Operation Management
      security:
        - BearerAuth: []
      parameters:
        - name: tripId
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - action
              properties:
                action:
                  type: string
                  enum: [CANCEL_TRIP, REASSIGN_DRIVER, REFUND]
                  example: "REASSIGN_DRIVER"
                reason:
                  type: string
                  example: "Tài xế hỏng xe giữa đường"
      responses:
        '200':
          description: Đã xử lý sự cố thành công.

  /admin/transactions:
    get:
      summary: FR60 - Tra cứu lịch sử giao dịch
      description: Nhân viên vận hành tra cứu danh sách lịch sử giao dịch thanh toán.
      operationId: adminGetTransactions
      tags:
        - Operation Management
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Danh sách giao dịch thanh toán.

  # =================================================================
  # NHÓM 10: AUTHORIZATION & AUDIT (FR61 - FR63)
  # =================================================================

  /admin/roles/check-permission:
    post:
      summary: FR61 & FR62 - Kiểm soát quyền truy cập & Hạn chế thao tác nhạy cảm
      description: Endpoint kiểm tra phân quyền người dùng trước khi cấp phép thực hiện các thao tác quản trị.
      operationId: checkPermission
      tags:
        - Authorization & Audit
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - staffId
                - permissionCode
              properties:
                staffId:
                  type: integer
                  example: 301
                permissionCode:
                  type: string
                  example: "MANAGE_REFUND"
      responses:
        '200':
          description: Trả về kết quả cho phép hoặc từ chối thao tác.

  /admin/audit-logs:
    get:
      summary: FR63 - Tra cứu Audit Log (Lưu vết thao tác quan trọng)
      description: Xem danh sách nhật ký ghi nhận các thao tác nhạy cảm và sự cố trên hệ thống.
      operationId: getAuditLogs
      tags:
        - Authorization & Audit
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Danh sách bản ghi audit log.

  # =================================================================
  # NHÓM 11: REPORTING (FR64 - FR68)
  # =================================================================

  /admin/reports/dashboard:
    get:
      summary: FR64 - FR68 - Thống kê và báo cáo vận hành tổng hợp
      description: >
        Cung cấp các số liệu báo cáo cho ban lãnh đạo và quản lý:
        - FR64: Thống kê số lượng chuyến
        - FR65: Thống kê doanh thu
        - FR66: Thống kê tỷ lệ chuyến hoàn thành
        - FR67: Thống kê tỷ lệ chuyến hủy
        - FR68: Thống kê hiệu quả hoạt động của tài xế
      operationId: getDashboardReport
      tags:
        - Reporting
      security:
        - BearerAuth: []
      parameters:
        - name: startDate
          in: query
          required: true
          schema:
            type: string
            format: date
            example: "2026-09-01"
        - name: endDate
          in: query
          required: true
          schema:
            type: string
            format: date
            example: "2026-09-09"
      responses:
        '200':
          description: Số liệu báo cáo thống kê tổng hợp.
          content:
            application/json:
              schema:
                type: object
                properties:
                  totalTrips:
                    type: integer
                    example: 1250
                  totalRevenue:
                    type: number
                    example: 185000000.0
                  completedRate:
                    type: number
                    example: 94.5
                  cancelledRate:
                    type: number
                    example: 5.5
                  driverPerformance:
                    type: array
                    items:
                      type: object
                      properties:
                        driverId:
                          type: integer
                          example: 201
                        driverName:
                          type: string
                          example: "Tran Van B"
                        completedTrips:
                          type: integer
                          example: 45
                        ratingAverage:
                          type: number
                          example: 4.9

# =================================================================
# COMPONENTS & SECURITY SCHEMES
# =================================================================
components:
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      
